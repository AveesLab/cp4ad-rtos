CPU mySystem {
	OS myOs {
		EE_OPT = "DEBUG";
		USERESSCHEDULER = TRUE;
		CPU_DATA = AVR8 {
			MULTI_STACK = TRUE;
		};
		MCU_DATA = MEGA {
			MODEL = MEGA_328p;
		};
		LIB = ARDUINO {
			SDK_BOARD = UNO;
			VARIANT = CC {
				VERSION = "1.8.16";
			};
			STAND_ALONE = TRUE;		// Generate arduino libraries
		};
		KERNEL_TYPE = OSEK {
			CLASS = ECC2;	// Default
		};
	};
	
	APPDATA myApp {
		APP_SRC = "bsw.cpp";
		APP_SRC = "asw.c";

		APP_SRC = "LiquidCrystal.cpp";
		
	};
	
	EVENT Event1 {
		MASK = AUTO;
	};

	TASK Task1 {
		PRIORITY = 1;
		STACK = SHARED;
		SCHEDULE = FULL;	// preemptive
		AUTOSTART = FALSE;	
        ACTIVATION = 1;		
	};

	TASK Task2 {
		PRIORITY = 2;
		STACK = PRIVATE {
			SIZE = 512;
		};
		SCHEDULE = FULL;
		EVENT = Event1;
		AUTOSTART = FALSE;
		ACTIVATION = 1;
	};

	ISR TimerISR {
		CATEGORY = 2;
		SOURCE = "TIMER1_COMPA";
	};

	COUNTER counter1 {
		MINCYCLE = 1;
		MAXALLOWEDVALUE = 127;
		TICKSPERBASE = 1;
	};

	ISR ButtonISR {
		// Write the code below.
		CATEGORY = 2;
		SOURCE = "PCINT1";
	};


	ALARM alarm1 {
		COUNTER = counter1;
		// Write the code below.
		ACTION = ACTIVATETASK {
			TASK = Task1;
		};
		
		AUTOSTART = TRUE {
			// Write the code below.
			ALARMTIME = 5;
			CYCLETIME = 1;
		};
	};
	

};